# =============================================================================
# MJ Forest Guru — environment variables
# Copy to .env.local for local development:   cp .env.example .env.local
# In production set these in Netlify → Site configuration → Environment variables.
# NEVER commit real values. Variables WITHOUT the NEXT_PUBLIC_ prefix are
# server-only and are never sent to the browser.
# =============================================================================

# --- Supabase (public: safe in the browser, RLS protects every row) ----------
# Project URL: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…). The legacy "anon" JWT also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY if you have not migrated to the new API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Application URL (auth redirects; never localhost in production) ---------
# Production: https://app.mjforestguru.com   Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Maps (optional) -----------------------------------------------------------
# Public Mapbox token for the satellite layer. Restrict it to your domain(s) in
# the Mapbox dashboard. Empty → free OpenFreeMap / Esri World Imagery tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- SERVER-ONLY SECRETS --------------------------------------------------------
# Service role key: bypasses RLS. Used ONLY server-side for invitations
# (auth admin API), integration secrets, the Mapon cron job and setup scripts.
# Supabase Dashboard → Project Settings → API → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Mapon GPS / telemetry API key (Mapon → Settings → API). When set it takes
# precedence over a key saved in Iestatījumi → Integrācijas.
MAPON_API_KEY=
# Optional override of the Mapon API base URL (default https://mapon.com/api/v1)
# MAPON_API_URL=https://mapon.com/api/v1

# Shared secret for scheduled jobs: the scheduler must send
#   Authorization: Bearer <CRON_SECRET>   to /api/cron/mapon
# Generate with:  openssl rand -hex 32   (minimum 16 characters)
CRON_SECRET=

# --- Application e-mail notifications (optional) --------------------------------
# Auth e-mails (invites, password reset) are sent by Supabase Auth SMTP — configure
# custom SMTP there. RESEND_API_KEY is only for in-app notification e-mails.
RESEND_API_KEY=
EMAIL_FROM="MJ Forest Guru <no-reply@mjforestguru.com>"

# --- Receipt OCR (optional, no provider ships with the MVP) --------------------
# RECEIPT_OCR_ENDPOINT=
# RECEIPT_OCR_TOKEN=

# --- Demo data (NEVER enable in production) -------------------------------------
# scripts/seed-demo.ts refuses to run unless this is "true".
ALLOW_DEMO_SEED=false

# --- Tests only -------------------------------------------------------------------
# Throw-away PostgreSQL database for the RLS test-suite (npm run test:db).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mjfg_test
